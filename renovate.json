{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "nix": {
    "enabled": true
  },
  "platformAutomerge": true,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpgradeTasks": {
        "commands": [
          "./nix/update-hashes.sh"
        ],
        "fileFilters": [
          "nix/server.nix"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "7 days",
      "postUpgradeTasks": {
        "commands": [
          "./nix/update-hashes.sh"
        ],
        "fileFilters": [
          "nix/web.nix"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "go dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow actions"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    }
  ]
}
