{
	admin off
	auto_https off
	persist_config off
}

:{$HOUSING_WEB_LISTEN_PORT:8080} {
	encode zstd gzip

	@server path /api/* /auth/*
	handle @server {
		reverse_proxy {$HOUSING_API_URL:http://127.0.0.1:8081} {
			flush_interval -1
		}
	}

	handle {
		root * {$HOUSING_WEB_ROOT}
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path / /200.html /service-worker.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /200.html
		file_server {
			precompressed br gzip
		}
	}
}
