{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{block "title" .}}{{end}} · housing</title>
<link rel="stylesheet" href="{{static "app.css"}}">
{{block "head" .}}{{end}}
</head>
<body>
<header class="top">
<nav>
  <a class="brand" href="/">housing</a>
  {{range .Nav}}<a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Label}}</a>
  {{end}}
</nav>
</header>
<main>
{{block "content" .}}{{end}}
</main>
</body>
</html>
{{end}}
{{define "star"}}<form method="post" action="{{.Action}}" class="star"><input type="hidden" name="on" value="{{if .On}}0{{else}}1{{end}}"><input type="hidden" name="next" value="{{.Next}}"><button type="submit" aria-pressed="{{.On}}" aria-label="{{if .On}}Remove from favorites{{else}}Add to favorites{{end}}" title="{{if .On}}Remove from favorites{{else}}Add to favorites{{end}}">{{if .On}}★{{else}}☆{{end}}</button></form>{{end}}
