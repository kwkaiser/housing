{{define "title"}}Map{{end}}
{{define "head"}}{{if .Data.Pins}}<link rel="stylesheet" href="{{static "leaflet/leaflet.css"}}">{{end}}{{end}}
{{define "content"}}{{with .Data}}
<h1>Map</h1>
{{if .First}}
<div class="controls">
  <details class="picker collections" hidden><summary>Collections</summary><div class="menu">
    {{range .Collections}}<label><input type="checkbox" data-collection="{{.ID}}" data-color="{{.Color}}" checked> <span class="swatch" style="background: {{.Color}}"></span> {{.ID}} <span class="muted">{{.Count}}{{with .Day}} · {{.}}{{end}}</span></label>
    {{end}}
  </div></details>
  <form method="get" action="/map" class="range">
    <span class="muted">First seen</span>
    <input type="date" name="from" value="{{.From}}" min="{{.Min}}" max="{{.Max}}" aria-label="First seen from">
    <span class="muted">to</span>
    <input type="date" name="to" value="{{.To}}" min="{{.Min}}" max="{{.Max}}" aria-label="First seen to">
    <button type="submit">Go</button>
    {{if or .From .To}}<a class="button" href="/map?from=">All dates</a>{{end}}
    {{if not .Default}}<a class="button" href="/map">Past month</a>{{end}}
  </form>
  <select class="fading" aria-label="Fading" hidden>
    <option value="">No fading</option>
    <option value="age" selected>Fade by age</option>
    <option value="match">Fade by match</option>
  </select>
  <span class="muted">{{len .Pins}} listings placed{{if .Approx}} · {{.Approx}} approximate from zip code{{end}}{{if .Filtered}} · {{.Filtered}} outside the date range{{end}}{{if .Unplaced}} · {{.Unplaced}} without a location{{end}}</span>
</div>
{{if .Pins}}
<div id="map" class="map"></div>
<script type="application/json" id="map-pins">{{.Pins}}</script>
<script src="{{static "leaflet/leaflet.js"}}" defer></script>
{{else}}
<p>No listings were first seen in this date range.</p>
{{end}}
<script src="{{static "map.js"}}" defer></script>
{{else if .Collections}}
<p>No listings with a location yet. Run a collection to fetch some.</p>
{{else}}
<p>There are no collections yet. <a href="/collections/new">Create one</a>, then run it.</p>
{{end}}
{{end}}{{end}}
