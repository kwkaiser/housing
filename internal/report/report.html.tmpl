<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #fafaf9;
  --fg: #1c1917;
  --muted: #78716c;
  --line: #e7e5e4;
  --stripe: #f5f5f4;
  --accent: #2563eb;
  --bad: #dc2626;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1c1917;
    --fg: #e7e5e4;
    --muted: #a8a29e;
    --line: #44403c;
    --stripe: #292524;
    --accent: #60a5fa;
    --bad: #f87171;
  }
}
body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--fg); font: 14px/1.45 system-ui, sans-serif; }
h1 { margin: 0 0 .25rem; font-size: 1.4rem; }
p { margin: 0 0 1rem; color: var(--muted); max-width: 70ch; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
.wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; }
th, td { padding: .5rem .75rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
th { position: sticky; top: 0; background: var(--bg); font-weight: 600; white-space: nowrap; cursor: pointer; user-select: none; }
th::after { content: ""; display: inline-block; width: 1em; color: var(--muted); }
th[aria-sort=ascending]::after { content: " ▲"; }
th[aria-sort=descending]::after { content: " ▼"; }
tbody tr:nth-child(even) { background: var(--stripe); }
.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.score { font-weight: 600; }
.bad { color: var(--bad); }
.summary { min-width: 24rem; max-width: 40rem; color: var(--muted); }
.tags { color: var(--muted); }
.off { display: none; }
.picker { position: relative; display: inline-block; margin: 0 0 1rem; }
.picker summary { list-style: none; padding: .35rem .75rem; border: 1px solid var(--line); border-radius: 6px; cursor: pointer; user-select: none; }
.picker summary::-webkit-details-marker { display: none; }
.picker summary::after { content: " ▾"; color: var(--muted); }
.picker[open] summary { border-color: var(--muted); }
#columns { position: absolute; z-index: 2; top: calc(100% + .25rem); left: 0; min-width: 12rem; max-height: 60vh; overflow-y: auto; padding: .35rem 0; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; box-shadow: 0 6px 20px rgb(0 0 0 / .15); }
#columns label { display: flex; align-items: center; gap: .5rem; padding: .3rem .75rem; cursor: pointer; white-space: nowrap; }
#columns label:hover { background: var(--stripe); }
#columns input { margin: 0; accent-color: var(--accent); }
.section { margin: 0 0 1rem; }
.section > summary { cursor: pointer; user-select: none; font-weight: 600; padding: .25rem 0; }
.section[open] > summary { margin-bottom: .5rem; }
table.profiles th { cursor: default; position: static; }
table.profiles th::after { content: none; }
table.profiles ul { margin: 0; padding-left: 1rem; }
table.profiles code + div { color: var(--muted); max-width: 16rem; }
</style>
</head>
<body>
<h1>{{.Title}}</h1>
<details class="section">
<summary>Profiles</summary>
<div class="wrap">
<table class="profiles">
<thead>
<tr>
  <th>Profile</th>
  <th>Summary</th>
  <th>Wants</th>
  <th>Avoids</th>
  <th>Reference</th>
</tr>
</thead>
<tbody>
{{range .Templates}}{{$t := .}}
<tr>
  <td><code>{{.Profile.ID}}</code><div>{{.Profile.Name}}</div></td>
  <td class="summary">{{.Profile.Summary}}</td>
  <td><ul>{{range .Profile.Want}}<li>{{.Label}} <span class="tags">{{.Importance}}</span></li>{{end}}</ul></td>
  <td><ul>{{range .Profile.Avoid}}<li>{{.Label}}{{if eq .Importance "essential"}} <span class="tags bad">dealbreaker</span>{{end}}</li>{{end}}</ul></td>
  <td>{{range .References}}<div><a href="{{.URL}}">{{address .}}</a>{{range $.Models}}{{with refScore $t .}} <span class="tags">{{.}}</span>{{end}}{{end}}</div>{{else}}-{{end}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
</details>
<details class="picker"><summary>Columns</summary><div id="columns"></div></details>
<div class="wrap">
<table id="listings">
<thead>
<tr>
  <th data-type="num" aria-sort="ascending">#</th>
  <th data-type="num">Match</th>
  <th data-type="num">Score</th>
  {{if gt (len .Templates) 1}}<th>Profile</th>{{end}}
  {{range .Columns}}<th data-type="num">{{.Label}}</th>{{end}}
  <th data-type="num">Coverage</th>
  <th data-type="num">Vibe</th>
  <th data-type="num">Price</th>
  <th data-type="num">Beds</th>
  <th>Address</th>
  <th>Sources</th>
  <th data-hidden>Dealbreakers</th>
  <th data-hidden>Missing</th>
  <th data-hidden>Avoids</th>
  <th>Summary</th>
</tr>
</thead>
<tbody>
{{range .Rows}}{{$row := .}}
<tr>
  <td class="num" data-sort="{{.Rank}}">{{.Rank}}</td>
  <td class="num score" data-sort="{{num .Match}}">{{match .Grade}}</td>
  <td class="num" data-sort="{{num .Score}}">{{printf "%.1f" .Score}}</td>
  {{if gt (len $.Templates) 1}}<td>{{.Profile}}</td>{{end}}
  {{range $.Columns}}{{with call .Cell $row}}<td class="num" data-sort="{{.Sort}}">{{.Text}}</td>{{end}}{{end}}
  <td class="num" data-sort="{{.Coverage}}">{{printf "%.0f%%" .Coverage}}</td>
  <td class="num" data-sort="{{.Vibe}}">{{.Vibe}}</td>
  <td class="num" data-sort="{{.Listing.Price.Cents}}">{{price .Listing}}</td>
  <td class="num" data-sort="{{bedsSort .Listing}}">{{beds .Listing}}</td>
  <td><a href="{{.Listing.URL}}">{{address .Listing}}</a></td>
  <td><a href="{{.Listing.URL}}">{{.Listing.Source}}</a>{{range .AlsoListed}}, <a href="{{.URL}}">{{.Source}}</a>{{end}}</td>
  <td class="tags bad">{{join .Dealbreakers ", "}}</td>
  <td class="tags">{{join .MissingEssentials ", "}}</td>
  <td class="tags">{{join .AvoidsHit ", "}}</td>
  <td class="summary">{{.Summary}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{range .Notes}}<p>{{.}}</p>{{end}}
<script>
const table = document.getElementById("listings");
const store = {
  get() { try { return JSON.parse(localStorage.getItem("columns")) || {}; } catch { return {}; } },
  set(v) { try { localStorage.setItem("columns", JSON.stringify(v)); } catch {} },
};
const shown = store.get();
table.tHead.rows[0].querySelectorAll("th").forEach((th, col) => {
  const name = th.textContent.trim();
  const show = (on) => {
    th.classList.toggle("off", !on);
    for (const tr of table.tBodies[0].rows) tr.cells[col].classList.toggle("off", !on);
  };
  const box = document.createElement("input");
  box.type = "checkbox";
  box.checked = shown[name] ?? !th.hasAttribute("data-hidden");
  box.addEventListener("change", () => {
    show(box.checked);
    shown[name] = box.checked;
    store.set(shown);
  });
  const label = document.createElement("label");
  label.append(box, name || "#");
  document.getElementById("columns").append(label);
  show(box.checked);

  th.addEventListener("click", () => {
    const body = th.closest("table").tBodies[0];
    const asc = th.getAttribute("aria-sort") !== "ascending";
    const num = th.dataset.type === "num";
    const key = (tr) => {
      const td = tr.cells[col];
      const v = td.dataset.sort ?? td.textContent.trim();
      return num ? (v === "" ? -Infinity : parseFloat(v)) : v.toLowerCase();
    };
    const rows = [...body.rows].sort((a, b) => {
      const x = key(a), y = key(b);
      return (x < y ? -1 : x > y ? 1 : 0) * (asc ? 1 : -1);
    });
    th.parentNode.querySelectorAll("th").forEach((h) => h.removeAttribute("aria-sort"));
    th.setAttribute("aria-sort", asc ? "ascending" : "descending");
    body.append(...rows);
  });
});
const picker = document.querySelector(".picker");
document.addEventListener("click", (e) => {
  if (!picker.contains(e.target)) picker.open = false;
});
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") picker.open = false;
});
</script>
</body>
</html>
