{{define "title"}}Map{{end}}
{{define "head"}}{{if .Data.RunFirst}}<link rel="stylesheet" href="{{static "leaflet/leaflet.css"}}">{{end}}{{end}}
{{define "content"}}{{with .Data}}
<h1>Map</h1>
{{if .RunFirst}}
<div class="controls">
  <details class="picker collections" hidden><summary>Collections</summary><div class="menu">
    {{range .Collections}}<label><input type="checkbox" data-collection="{{.ID}}" data-color="{{.Color}}" checked> <span class="swatch" style="background: {{.Color}}"></span> {{.ID}} <span class="muted">{{.Count}}{{with .Day}} · {{.}}{{end}}</span></label>
    {{end}}
  </div></details>
  <form method="get" action="/map" class="range">
    <span class="muted">Retrieved</span>
    <input type="date" name="from" value="{{.From}}" min="{{.Min}}" max="{{.Max}}" aria-label="Retrieved from">
    <span class="muted">to</span>
    <input type="date" name="to" value="{{.To}}" min="{{.Min}}" max="{{.Max}}" aria-label="Retrieved to">
    {{$custom := true}}{{range .Quick}}{{if .Active}}{{$custom = false}}{{end}}{{end}}<select class="quick" aria-label="Quick">
      <option value="" disabled{{if $custom}} selected{{end}}>Quick</option>
      {{range .Quick}}<option value="{{.Href}}"{{if .Active}} selected{{end}}>{{.Label}}</option>
      {{end}}
    </select>
  </form>
  <select class="fading" aria-label="Fading" hidden>
    <option value="">No fading</option>
    <option value="age" selected>Fade by age</option>
    <option value="match">Fade by match</option>
  </select>
  <label class="toggle contrast" hidden>Contrast <input type="range" min="0" max="100" value="50" aria-label="Fading contrast"></label>
  <label class="toggle show" hidden><input type="checkbox" data-show="dealbreakers"> Show dealbreakers</label>
  <label class="toggle show" hidden><input type="checkbox" data-show="ungraded"> Show ungraded</label>
  <span class="muted">{{len .Pins}} listings placed{{if .Approx}} · {{.Approx}} approximate from zip code{{end}}{{if .Dealbreakers}} · {{.Dealbreakers}} with dealbreakers{{end}}{{if .Ungraded}} · {{.Ungraded}} ungraded{{end}}{{if .Unplaced}} · {{.Unplaced}} without a location{{end}}</span>
</div>
<div id="map" class="map"></div>
<script type="application/json" id="map-config">{{.Config}}</script>
<script type="application/json" id="map-pins">{{.Pins}}</script>
<script type="application/json" id="map-extent">{{.Extent}}</script>
<script src="{{static "leaflet/leaflet.js"}}" defer></script>
<script src="{{static "vector-overlay.js"}}" defer></script>
<script src="{{static "map-layers.js"}}" defer></script>
<script src="{{static "map.js"}}" defer></script>
{{else if .Collections}}
<p>No listings with a location yet. Run a collection to fetch some.</p>
{{else}}
<p>There are no collections yet. <a href="/collections/new">Create one</a>, then run it.</p>
{{end}}
{{end}}{{end}}
